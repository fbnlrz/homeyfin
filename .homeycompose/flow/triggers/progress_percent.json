{
  "title": {
    "en": "Progress reached %",
    "de": "Fortschritt erreicht %",
    "nl": "Voortgangspercentage bereikt"
  },
  "hint": {
    "en": "Fires once per item when playback crosses the given percentage.",
    "de": "Wird einmal pro Item ausgelöst, wenn der Fortschritt den Prozentsatz überschreitet.",
    "nl": "Wordt eenmaal per item geactiveerd wanneer het afspelen het opgegeven percentage passeert."
  },
  "titleFormatted": {
    "en": "Reached [[percent]]% of item",
    "de": "Erreicht [[percent]] % des Items",
    "nl": "[[percent]]% van item bereikt"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=user"
    },
    {
      "name": "percent",
      "type": "number",
      "title": {
        "en": "Percent",
        "de": "Prozent",
        "nl": "Procent"
      },
      "min": 1,
      "max": 99,
      "step": 1,
      "placeholder": {
        "en": "50",
        "de": "50",
        "nl": "50"
      }
    }
  ],
  "tokens": [
    {
      "name": "title",
      "type": "string",
      "title": {
        "en": "Title",
        "de": "Titel",
        "nl": "Titel"
      }
    },
    {
      "name": "type",
      "type": "string",
      "title": {
        "en": "Type",
        "de": "Typ",
        "nl": "Type"
      }
    }
  ]
}
